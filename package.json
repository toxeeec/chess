{
	"$schema": "https://www.schemastore.org/package.json",
	"name": "chess",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"build": "vite build",
		"build:game-server": "cargo build --manifest-path game-server/Cargo.toml --target wasm32-unknown-unknown && wasm-bindgen game-server/target/wasm32-unknown-unknown/debug/game_server.wasm --target module --typescript --out-dir game-server/build --experimental-reset-state-function && node scripts/patchGameServerWasmImport.mjs",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"deploy": "pnpm run build && wrangler deploy",
		"dev": "portless run vite dev",
		"fmt": "oxfmt && cargo fmt --manifest-path game-server/Cargo.toml",
		"fix:rs": "cargo clippy --fix --allow-dirty --allow-staged --manifest-path game-server/Cargo.toml -- --deny warnings",
		"fix:ts": "oxlint --fix",
		"fix": "status=0; pnpm run fix:ts || status=1; pnpm run fix:rs || status=1; exit $status",
		"generate-types": "wrangler types",
		"prepare": "prek install --quiet --prepare-hooks",
		"preview": "vite preview",
		"skills:install": "skills experimental_install",
		"test:rs": "cargo test --manifest-path game-server/Cargo.toml",
		"test:ts": "vitest run",
		"test": "status=0; pnpm run test:ts || status=1; pnpm run test:rs || status=1; exit $status"
	},
	"dependencies": {
		"@dnd-kit/abstract": "^0.5.0",
		"@dnd-kit/dom": "^0.5.0",
		"@dnd-kit/react": "^0.5.0",
		"@tanstack/react-router": "1.170.29",
		"@tanstack/react-start": "1.168.46",
		"drizzle-orm": "1.0.0-rc.3",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.52.1",
		"@cloudflare/vitest-pool-workers": "^0.21.3",
		"@j178/prek": "^0.4.13",
		"@rolldown/plugin-babel": "^0.2.3",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/devtools-vite": "0.8.3",
		"@tanstack/react-devtools": "0.10.10",
		"@tanstack/react-router-devtools": "1.167.1",
		"@tanstack/router-plugin": "^1.168.32",
		"@tanstack/start-storage-context": "^1.167.26",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"babel-plugin-react-compiler": "^1.0.0",
		"drizzle-kit": "1.0.0-rc.3",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.78.0",
		"oxlint-tsgolint": "^7.0.2001",
		"portless": "^0.15.5",
		"skills": "^1.5.22",
		"tailwindcss": "^4.3.3",
		"vite": "^8.2.1",
		"vitest": "^4.1.10",
		"wrangler": "^4.123.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": ">=11.0.0",
			"onFail": "error"
		}
	}
}
